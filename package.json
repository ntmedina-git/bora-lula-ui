{
  "name": "@boralula/ui",
  "version": "0.1.0",
  "description": "Biblioteca de componentes React do Comitê Popular / Bora Lula. Tokens, componentes e regras de acessibilidade do Guia de Interface Web e Apps.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./tailwind-preset": "./tokens/tailwind-preset.cjs",
    "./fonts.css": "./dist/fonts.css"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "storybook dev -p 6006",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build-storybook": "npm run tokens && storybook build -o storybook-static && node scripts/postbuild-storybook.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "lucide-react": "^1.55.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
